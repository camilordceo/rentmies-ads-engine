# ════════════════════════════════════════════════════
# RENTMIES ADS ENGINE — VARIABLES DE ENTORNO
# Copia este archivo a .env y llena las claves reales.
# Sin claves: el sistema corre con mock data completo.
# ════════════════════════════════════════════════════

PORT=3000

# ── Google AI (Gemini + Imagen 3) ──
# Obtén tu key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Meta / Facebook Ads ──
# Obtén desde: https://developers.facebook.com/tools/explorer/
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=

# ── TikTok Ads ──
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_ADGROUP_ID=

# ── WhatsApp Business ──
# Número en formato internacional (sin + ni espacios)
WHATSAPP_NUMBER=573001234567
