{
  "rewrites": [
    { "source": "/login",                  "destination": "/login.html" },
    { "source": "/signup",                 "destination": "/signup.html" },
    { "source": "/app",                    "destination": "/app/index.html" },
    { "source": "/app/(.*)",               "destination": "/app/index.html" },
    { "source": "/dashboard",              "destination": "/dashboard/index.html" },
    { "source": "/onboarding/post-oauth",  "destination": "/onboarding/post-oauth.html" },
    { "source": "/onboarding/select-page", "destination": "/onboarding/select-page.html" },
    { "source": "/onboarding/payment",     "destination": "/onboarding/payment.html" },
    { "source": "/onboarding/no-pages",    "destination": "/onboarding/no-pages.html" },
    { "source": "/welcome",                "destination": "/welcome.html" }
  ],
  "functions": {
    "api/**/*.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron-publish",                "schedule": "55 13 * * *" },
    { "path": "/api/cron-refresh-tokens",         "schedule": "0 3 * * *" },
    { "path": "/api/cron-renew-subscriptions",    "schedule": "0 4 * * *" },
    { "path": "/api/cron/process-broadcasts",     "schedule": "* * * * *" },
    { "path": "/api/cron/google-token-refresh",   "schedule": "0 4 * * *" },
    { "path": "/api/cron/google-recommendations", "schedule": "0 */6 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
