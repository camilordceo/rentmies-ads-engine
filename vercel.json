{
  "rewrites": [
    { "source": "/login",        "destination": "/public/login.html" },
    { "source": "/signup",       "destination": "/public/signup.html" },
    { "source": "/app",          "destination": "/dashboard/index.html" },
    { "source": "/app/(.*)",     "destination": "/dashboard/index.html" },
    { "source": "/dashboard",    "destination": "/dashboard/index.html" },
    { "source": "/dashboard/((?!index\\.html).*)", "destination": "/dashboard/$1" },
    { "source": "/",             "destination": "/public/index.html" },
    { "source": "/((?!api/).*)", "destination": "/public/index.html" }
  ],
  "functions": {
    "api/generate.js":         { "maxDuration": 30 },
    "api/generate-video.js":   { "maxDuration": 120 },
    "api/meta-ads.js":         { "maxDuration": 30 },
    "api/instagram.js":        { "maxDuration": 60 },
    "api/tiktok.js":           { "maxDuration": 60 },
    "api/schedule-plan.js":    { "maxDuration": 30 },
    "api/cron-publish.js":     { "maxDuration": 60 },
    "api/auth.js":             { "maxDuration": 15 },
    "api/auth-supabase.js":    { "maxDuration": 15 },
    "api/data.js":             { "maxDuration": 30 },
    "api/google-ads.js":       { "maxDuration": 30 },
    "api/health.js":           { "maxDuration": 10 },
    "api/social-post.js":      { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron-publish", "schedule": "55 13 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
