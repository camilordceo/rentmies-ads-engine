{
  "rewrites": [
    { "source": "/login",                  "destination": "/login.html" },
    { "source": "/signup",                 "destination": "/signup.html" },
    { "source": "/app",                    "destination": "/app/index.html" },
    { "source": "/app/(.*)",               "destination": "/app/index.html" },
    { "source": "/dashboard",              "destination": "/dashboard/index.html" },
    { "source": "/onboarding/post-oauth",  "destination": "/onboarding/post-oauth.html" },
    { "source": "/onboarding/select-page", "destination": "/onboarding/select-page.html" },
    { "source": "/onboarding/payment",     "destination": "/onboarding/payment.html" },
    { "source": "/onboarding/no-pages",    "destination": "/onboarding/no-pages.html" },
    { "source": "/welcome",                "destination": "/welcome.html" }
  ],
  "functions": {
    "api/generate.js":              { "maxDuration": 30 },
    "api/meta-ads.js":              { "maxDuration": 30 },
    "api/cron-publish.js":          { "maxDuration": 60 },
    "api/cron-refresh-tokens.js":   { "maxDuration": 60 },
    "api/auth-supabase.js":         { "maxDuration": 15 },
    "api/auth/meta/login.js":       { "maxDuration": 10 },
    "api/auth/meta/callback.js":    { "maxDuration": 30 },
    "api/auth/meta/connection.js":  { "maxDuration": 10 },
    "api/auth/meta/health.js":      { "maxDuration": 15 },
    "api/auth/meta/disconnect.js":  { "maxDuration": 10 },
    "api/onboarding/select-page.js":{ "maxDuration": 15 },
    "api/credentials/meta/index.js":   { "maxDuration": 10 },
    "api/credentials/meta/test.js":    { "maxDuration": 20 },
    "api/credentials/meta/health.js":  { "maxDuration": 10 },
    "api/wizard/validate-token.js":    { "maxDuration": 20 },
    "api/wizard/config.js":            { "maxDuration": 5 },
    "api/posts/publish/facebook.js":   { "maxDuration": 30 },
    "api/posts/publish/instagram.js":  { "maxDuration": 60 },
    "api/posts/list.js":               { "maxDuration": 10 },
    "api/media/upload.js":             { "maxDuration": 30 },
    "api/data.js":                  { "maxDuration": 30 },
    "api/health.js":                { "maxDuration": 10 },
    "api/social-post.js":           { "maxDuration": 60 },
    "api/ai.js":                    { "maxDuration": 60 },
    "api/wompi/plans.js":              { "maxDuration": 10 },
    "api/wompi/acceptance-tokens.js":  { "maxDuration": 10 },
    "api/wompi/checkout.js":           { "maxDuration": 30 },
    "api/wompi/webhook.js":            { "maxDuration": 15 },
    "api/wompi/subscription.js":       { "maxDuration": 10 },
    "api/cron-renew-subscriptions.js": { "maxDuration": 60 },
    "api/cron/process-broadcasts.js":     { "maxDuration": 60 },
    "api/cron/google-token-refresh.js":   { "maxDuration": 60 },
    "api/cron/google-recommendations.js": { "maxDuration": 60 },
    "api/whatsapp/templates/sync.js":   { "maxDuration": 30 },
    "api/whatsapp/templates/submit.js": { "maxDuration": 30 },
    "api/whatsapp/templates/save.js":   { "maxDuration": 15 },
    "api/whatsapp/templates/list.js":   { "maxDuration": 15 },
    "api/whatsapp/templates/create.js": { "maxDuration": 15 },
    "api/whatsapp/broadcasts/list.js":  { "maxDuration": 15 },
    "api/whatsapp/broadcasts/create.js":{ "maxDuration": 30 },
    "api/whatsapp/broadcasts/start.js": { "maxDuration": 15 },
    "api/whatsapp/broadcasts/get.js":   { "maxDuration": 10 },
    "api/whatsapp/broadcasts/pause.js": { "maxDuration": 5 },
    "api/whatsapp/broadcasts/resume.js":{ "maxDuration": 5 },
    "api/whatsapp/broadcasts/cancel.js":{ "maxDuration": 10 },
    "api/whatsapp/broadcasts/resend-unread.js": { "maxDuration": 30 },
    "api/google/connection.js":         { "maxDuration": 10 },
    "api/google/campaigns/list.js":     { "maxDuration": 30 },
    "api/google/campaigns/create.js":   { "maxDuration": 15 },
    "api/google/campaigns/create-pmax.js": { "maxDuration": 60 },
    "api/google/campaigns/pause.js":    { "maxDuration": 20 },
    "api/google/campaigns/enable.js":   { "maxDuration": 20 },
    "api/google/oauth/start.js":        { "maxDuration": 5 },
    "api/google/oauth/callback.js":     { "maxDuration": 30 },
    "api/google/leads/list.js":         { "maxDuration": 10 },
    "api/google/leads/update.js":       { "maxDuration": 5 },
    "api/google/recommendations/list.js":    { "maxDuration": 5 },
    "api/google/recommendations/dismiss.js": { "maxDuration": 5 },
    "api/webhooks/google-leads.js":     { "maxDuration": 15 },
    "api/webhooks/meta.js":             { "maxDuration": 15 },
    "api/tiktok/connection.js":         { "maxDuration": 10 },
    "api/tiktok/oauth/start.js":        { "maxDuration": 5 },
    "api/tiktok/oauth/callback.js":     { "maxDuration": 15 },
    "api/tiktok/videos/list.js":        { "maxDuration": 15 }
  },
  "crons": [
    { "path": "/api/cron-publish",              "schedule": "55 13 * * *" },
    { "path": "/api/cron-refresh-tokens",       "schedule": "0 3 * * *" },
    { "path": "/api/cron-renew-subscriptions",  "schedule": "0 4 * * *" },
    { "path": "/api/cron/process-broadcasts",     "schedule": "* * * * *" },
    { "path": "/api/cron/google-token-refresh",   "schedule": "0 4 * * *" },
    { "path": "/api/cron/google-recommendations", "schedule": "0 */6 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
