{
  "rewrites": [
    { "source": "/studio",        "destination": "/studio.html" },
    { "source": "/studio/(.*)",   "destination": "/studio.html" },
    { "source": "/app",           "destination": "/studio.html" },
    { "source": "/dashboard",     "destination": "/studio.html" },
    { "source": "/((?!api|studio|app|dashboard|_next|public).*\\..+)", "destination": "/$1" },
    { "source": "/((?!api/).*)",  "destination": "/index.html" }
  ],
  "functions": {
    "api/generate.js":         { "maxDuration": 30 },
    "api/generate-video.js":   { "maxDuration": 120 },
    "api/meta-ads.js":         { "maxDuration": 30 },
    "api/instagram.js":        { "maxDuration": 60 },
    "api/tiktok.js":           { "maxDuration": 60 },
    "api/schedule-plan.js":    { "maxDuration": 30 },
    "api/cron-publish.js":     { "maxDuration": 60 },
    "api/auth.js":             { "maxDuration": 15 },
    "api/data.js":             { "maxDuration": 30 },
    "api/google-ads.js":       { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron-publish", "schedule": "55 13 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
