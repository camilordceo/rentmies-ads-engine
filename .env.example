# ════════════════════════════════════════════════════
# RENTMIES ADS ENGINE — ENV EXAMPLE
# Copy this file to adsplatform.env and fill in real values.
# NEVER commit adsplatform.env or any file with real keys.
# ════════════════════════════════════════════════════

PORT=3000
NODE_ENV=development

# ── Supabase ──────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Google AI (Gemini + Imagen 3) ─────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here
GOOGLE_AI_API_KEY=your-google-ai-key-here

# ── Meta / Facebook ───────────────────────────────────────────────
# Get from: https://developers.facebook.com/tools/explorer/
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret
# Used by the legacy /app dashboard for server-side fallback only.
# For new users, tokens come from the OAuth flow and live in meta_connections.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXXX
META_PAGE_ID=
META_WABA_ID=
META_PHONE_NUMBER_ID=

# ── Meta Login for Business OAuth ─────────────────────────────────
# Setup guide: docs/META_APP_SETUP.md
# Get LOGIN_CONFIG_ID from: developers.facebook.com → your app
#   → Facebook Login for Business → Configurations → "Rentmies Connect"
META_LOGIN_CONFIG_ID=
META_REDIRECT_URI=https://rentmies-ads-engine.vercel.app/api/auth/meta/callback
META_GRAPH_VERSION=v21.0
# Generate with: openssl rand -hex 32
META_OAUTH_SECRET=

# ── Google Ads (Bloque 3) ─────────────────────────────────────────
# Setup:
#   1. ads.google.com/home/tools/manager-accounts → create MCC
#   2. MCC → Tools & Settings → API Center → Apply for developer token
#      (1-3 weeks for approval — start ASAP)
#   3. console.cloud.google.com → New Project → enable "Google Ads API"
#   4. Credentials → OAuth 2.0 Client (Desktop application)
#   5. Add the Authorized redirect URI matching GOOGLE_ADS_REDIRECT_URI below
GOOGLE_ADS_DEVELOPER_TOKEN=22-char-token
GOOGLE_ADS_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890
GOOGLE_ADS_REDIRECT_URI=https://rentmies-ads-engine.vercel.app/api/google/oauth/callback
# CSRF state token signing — generate with: openssl rand -hex 32
GOOGLE_OAUTH_STATE_SECRET=
# Optional webhook signing secret for /api/webhooks/google-leads
GOOGLE_LEADS_WEBHOOK_SECRET=

# ── Webhook verification ──────────────────────────────────────────
# Used by /api/webhooks/meta during the verification handshake (Step 16).
# Choose any string and paste the same value in Meta App Dashboard → Webhooks.
META_WEBHOOK_VERIFY_TOKEN=

# ── Cron secret ───────────────────────────────────────────────────
# Vercel auto-injects this when scheduled crons run; setting it here
# also lets you protect the cron endpoints from external triggers.
CRON_SECRET=

# ── TikTok Ads ────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=your-client-key
TIKTOK_CLIENT_SECRET=your-client-secret
TIKTOK_REDIRECT_URI=https://your-app.vercel.app/api/auth?action=callback
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# ── Wompi (Bancolombia) ───────────────────────────────────────────
# Setup guide: docs/WOMPI_SETUP.md
# Dashboard: https://comercios.wompi.co → Development → Developers
# Reglas:
#   - sandbox keys (pub_test_/prv_test_) → sandbox URL (auto)
#   - production keys (pub_prod_/prv_prod_) → production URL
#   - Nunca mezclar sandbox y producción
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_xxx
WOMPI_PRIVATE_KEY=prv_test_xxx
WOMPI_EVENTS_SECRET=test_events_xxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxx

# ── App ───────────────────────────────────────────────────────────
APP_URL=https://your-app.vercel.app
# Optional: protect API endpoints with a static key (leave blank for open dev mode)
RENTMIES_API_KEY=
