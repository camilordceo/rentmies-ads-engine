# ════════════════════════════════════════════════════
# RENTMIES ADS ENGINE — ENV EXAMPLE
# Copy this file to adsplatform.env and fill in real values.
# NEVER commit adsplatform.env or any file with real keys.
# ════════════════════════════════════════════════════

PORT=3000
NODE_ENV=development

# ── Supabase ──────────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── Google AI (Gemini + Imagen 3) ─────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-key-here
GOOGLE_AI_API_KEY=your-google-ai-key-here

# ── Meta / Facebook ───────────────────────────────────────────────
# Get from: https://developers.facebook.com/tools/explorer/
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret
META_ACCESS_TOKEN=your-long-lived-token
META_AD_ACCOUNT_ID=act_XXXXXXXXX
META_PAGE_ID=your-page-id
META_WABA_ID=your-whatsapp-business-account-id
META_PHONE_NUMBER_ID=your-phone-number-id

# ── TikTok Ads ────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=your-client-key
TIKTOK_CLIENT_SECRET=your-client-secret
TIKTOK_REDIRECT_URI=https://your-app.vercel.app/api/auth?action=callback
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# ── App ───────────────────────────────────────────────────────────
APP_URL=https://your-app.vercel.app
# Optional: protect API endpoints with a static key (leave blank for open dev mode)
RENTMIES_API_KEY=
